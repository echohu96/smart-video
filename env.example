# AI Provider Configuration
# Choose one or more providers
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Alternative: Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Download Configuration (No video files, only subtitles)
SUBTITLE_LANGUAGES=en,zh,zh-Hans,zh-Hant
AUTO_DOWNLOAD_SUBTITLES=true
CACHE_SUBTITLES=true  # Optional: cache subtitle files

# Path Configuration
CACHE_DIR=./cache
SUBTITLE_CACHE_DIR=./cache/subtitles  # Optional: subtitle cache
TEMP_DIR=./cache/temp                 # Temporary files (audio for transcription)
OUTPUT_DIR=./output/summaries         # Summary output directory

# Optional: Whisper for transcription (if no subtitles available)
USE_WHISPER=false
WHISPER_MODEL=base

# Optional: Proxy Configuration
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Logging
LOG_LEVEL=INFO

